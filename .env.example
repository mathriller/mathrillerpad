# ─────────────────────────────────────────────────────────────
# MathrillerPad 환경 변수 (이 파일을 .env 로 복사해서 사용하세요)
# ─────────────────────────────────────────────────────────────

# 1) Google Apps Script 웹 앱 배포 URL
#    비워두면 브라우저 localStorage 를 사용하는 "데모(Mock) 모드"로 동작합니다.
VITE_GAS_URL=

# 2) 데모(Mock) 모드 전용 관리자 비밀번호
#    ※ 실제 운영(GAS 연결) 시 비밀번호 검증은 백엔드(google-sheet-db.gs)의
#      ADMIN_PASSWORD (또는 스크립트 속성 ADMIN_PASSWORD)에서 수행됩니다.
VITE_ADMIN_PASSWORD=admin1234

# 3) 보드 자동 새로고침(실시간 동기화) 주기 (밀리초)
VITE_POLL_INTERVAL=10000
